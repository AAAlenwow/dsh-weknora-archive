{
  "name": "dsh-weknora-archive",
  "version": "0.4.0",
  "description": "Incrementally archive DSH sessions into a WeKnora knowledge base (Tencent WeKnora RAG): extract, summarize, dedupe, upload, verify parse status, and render a local three.js ingestion report. 把 DSH 会话增量归档进 WeKnora 知识库（写入侧互补官方只读 dsh-weknora 插件），含解析状态核验与本地 three.js 入库报告。",
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "weknora",
    "knowledge-base",
    "session-archive",
    "rag"
  ],
  "license": "MIT",
  "type": "module",
  "main": "./lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json"
  },
  "files": [
    "cordis.patch.yml",
    "lib",
    "visualizer",
    "test",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=24.0",
    "dsh": ">=0.1.7-alpha.1"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "compatibility": {
      "dsh": ">=0.1.7-alpha.1",
      "profiles": [
        "web"
      ]
    }
  },
  "scripts": {
    "test": "node test/mock.test.mjs"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/AAAlenwow/dsh-weknora-archive.git"
  }
}
